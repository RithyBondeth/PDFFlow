# PDFFlow — production environment template.
#
# Copy to .env on the production host. Do not reuse the development .env:
# the values below assume TLS termination in nginx and a real origin.
#
#   cp .env.production.example .env
#
# Issue the first certificate, then start with the production overlay. The
# exact commands are in README.md. The --env-file flag is required:
# two -f flags move Compose's project directory to infrastructure/, where
# there is no .env, and every value below would silently revert to its
# development default.
#
#   docker compose --env-file .env \
#                  -f infrastructure/docker-compose.yml \
#                  -f infrastructure/docker-compose.prod.yml up -d --build

# --- ports -------------------------------------------------------------
# 80 serves only the ACME challenge and the redirect to HTTPS.
HTTP_PORT=80
HTTPS_PORT=443

# --- TLS ---------------------------------------------------------------
# The whole certbot tree, mounted at /etc/letsencrypt in both nginx and
# certbot. Point this at the *root* of the tree, never at live/<domain> — the
# files there are symlinks into ../../archive/ and dangle if archive/ is not
# mounted alongside them.
#
# ./letsencrypt keeps the material next to the stack; /etc/letsencrypt reuses
# a certbot installation already on the host. Either works.
LETSENCRYPT_DIR=./letsencrypt
ACME_WEBROOT=./certbot-webroot

# --- environment -------------------------------------------------------
ENVIRONMENT=production
DEBUG=false

# --- postgres ----------------------------------------------------------
# REPLACE THIS. Generate one with:  openssl rand -base64 32
POSTGRES_USER=pdfflow
POSTGRES_PASSWORD=REPLACE-ME-BEFORE-LAUNCH
POSTGRES_DB=pdfflow

# --- limits ------------------------------------------------------------
# 100 MB
MAX_UPLOAD_BYTES=104857600
MAX_FILES_PER_JOB=25
# How long an uploaded file or a result survives before the sweep deletes it.
FILE_TTL_MINUTES=30
CLEANUP_INTERVAL_SECONDS=300

# --- security ----------------------------------------------------------
# The real origin only. A wildcard here would let any site drive the API on a
# visitor's behalf.
CORS_ORIGINS=https://pdfflow.bondeth.site
RATE_LIMIT_UPLOADS=30/minute
RATE_LIMIT_JOBS=60/minute

# Networks whose X-Forwarded-For is believed when deciding who to rate limit.
# Our nginx is the only thing that reaches the API and it sits on the compose
# bridge network, which Docker allocates out of 172.16.0.0/12. Anything wider
# than the network nginx is actually on lets a host inside that range forge a
# client IP and slip the limits.
#
# Narrow this to the project's own subnet once it is stable:
#   docker network inspect pdfflow_default -f '{{range .IPAM.Config}}{{.Subnet}}{{end}}'
TRUSTED_PROXIES=127.0.0.0/8,::1/128,172.16.0.0/12
