# Copy to .env — `docker compose up` reads it automatically.
# There are no secrets for user data here because PDFFlow stores no user data.

# --- ports -------------------------------------------------------------
HTTP_PORT=8080

# --- environment -------------------------------------------------------
ENVIRONMENT=development
DEBUG=false

# --- postgres ----------------------------------------------------------
POSTGRES_USER=pdfflow
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=pdfflow

# --- limits ------------------------------------------------------------
# 100 MB
MAX_UPLOAD_BYTES=104857600
MAX_FILES_PER_JOB=25
# How long an uploaded file or a result survives before the sweep deletes it.
FILE_TTL_MINUTES=30
CLEANUP_INTERVAL_SECONDS=300

# --- security ----------------------------------------------------------
CORS_ORIGINS=http://localhost:8080,http://localhost:3000
RATE_LIMIT_UPLOADS=30/minute
RATE_LIMIT_JOBS=60/minute
